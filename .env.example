# Monarch Smart CFO — Runtime Environment Variables (Never commit your actual .env file)
PORT=3080
DATA_DIR=/data

# Optional: Monarch Official MCP OAuth Bearer Token (or configure via the Web UI)
MONARCH_MCP_URL=https://api.monarch.com/mcp
MONARCH_OAUTH_TOKEN=
MONARCH_WRITE_ENABLED=true

# Optional: Household Partner Display Names
PARTNER_A_NAME=Partner A
PARTNER_B_NAME=Partner B

# Optional: Cash Sweep & Runway Defaults
CHECKING_SAFETY_BUFFER=3500
HYSA_TARGET_APY=4.50

# Optional: Hybrid Narrative AI Provider (hybrid_agent | ollama | gemini | anthropic | openai)
LLM_PROVIDER=hybrid_agent
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
OLLAMA_URL=

# Optional: Alert Webhooks (none | discord | slack | ntfy | home_assistant)
WEBHOOK_TYPE=none
WEBHOOK_URL=
